# 复制为 .env 并填入真实值：cp .env.example .env
#
# .env 已被 .gitignore 排除；本文件（.env.example）不含任何密钥，可以提交。
# launch.py / watch.py 会自动读取 .env —— 已存在的同名环境变量优先。

# ── 必需 ──
# RunPod console → Settings → API Keys
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 建好资源后填入 ──
# RunPod console → Storage → Network Volume（checkpoint 持久化的前提）
# NETWORK_VOLUME_ID=nv-xxxxxxxxxxxx

# 镜像仓库（在 RunPod Pod 里构建后推送，不要在 Apple Silicon 本地 build）
# IMAGE_NAME=yourdockerhub/minimind-runpod:latest

# ── 可选 ──
# runpod/pytorch 基础镜像已预设 HF_HUB_ENABLE_HF_TRANSFER=1。
# 拉私有 HF 数据集/模型时需要 token（公开资源不需要）
# HF_TOKEN=hf_xxxxxxxx

# 训练指标上报（配合 configs 里的 --use_wandb）
# WANDB_API_KEY=xxxxxxxx
