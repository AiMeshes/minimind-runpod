# 64M 从头预训练 —— 最小可用配置
#
# 参考成本: 8×4090 Spot 约 $2.72/hr；200B tokens 约 $1,110
# 本配置跑通流程的实测成本 < $1
#
# 用法:
#   cp .env.example .env     # 填 RUNPOD_API_KEY
#   python launch.py --config configs/64m-pretrain.env
#
# 校验请求体（不会真的创建）:
#   python launch.py --config configs/64m-pretrain.env --dry-run

# --- 镜像（必需）---
# 在 RunPod 的 Pod 里构建后推送，不要在 Apple Silicon 本地 build
# （qemu 模拟编译 amd64 极慢甚至失败，见成本指南 §8.3）
IMAGE_NAME=yourdockerhub/minimind-runpod:latest

# --- 持久化（必需，抗抢占的前提）---
# RunPod console → Storage 建 network volume。
# ⚠️ 地域锁定：volume 在哪个机房，Pod 就只能开在哪个机房。
#    若 Pod 起不来，多半是该机房没有 GPU_TYPE 的现货。
NETWORK_VOLUME_ID=nv-xxxxxxxxxxxx

# 可选：显式指定机房（填了就不用猜 volume 在哪）
# 取值见 https://rest.runpod.io/v1/openapi.json 的 dataCenterIds 枚举
# DATA_CENTER_IDS=US-CA-2

# --- 实例类型 ---
# COMMUNITY + INTERRUPTIBLE=1 = Spot（比按需便宜约 50%）
# 注意：需要一个能读 checkpoint 的 --from_resume 训练脚本，本项目已满足
CLOUD_TYPE=COMMUNITY
INTERRUPTIBLE=1

POD_NAME=minimind-64m-pretrain

# 合法取值见 OpenAPI spec 的 gpuTypeIds 枚举（45 种）
# 本区间主力推荐：NVIDIA GeForce RTX 4090（每美元有效算力最高）
GPU_TYPE=NVIDIA GeForce RTX 4090
GPU_COUNT=8

# 容器盘易失，只放系统依赖 —— checkpoint 一律走 network volume
CONTAINER_DISK_GB=40

# Jupyter / SSH 调试入口。22/tcp 用于 SSH
PORTS=8888/http,22/tcp

# --- 数据 ---
# 留空则跳过下载（适用于数据已预置在 network volume 的情况）
DATA_URL=

# --- 代码 ---
MINIMIND_REPO=https://github.com/AiMeshes/minimind.git

# --- 训练超参 ---
# entrypoint 按空格拆分后转发给 train_pretrain.py；留空用 minimind 默认值
TRAIN_ARGS=--epochs 2 --batch_size 32 --learning_rate 5e-4 --save_interval 1000

# --- 可选 ---
# 设为 1 启动 sshd（本镜像覆盖了基座 ENTRYPOINT，会丢掉 RunPod 的 /start.sh）
# 公钥由 RunPod 的 PUBLIC_KEY 环境变量注入
# START_SSHD=0

# 凭据放 .env，不要写在这里（本文件会进仓库）
# HF_TOKEN / WANDB_API_KEY 见 .env.example
