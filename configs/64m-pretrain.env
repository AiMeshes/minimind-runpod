# 64M 从头预训练 —— 最小可用配置
#
# 参考成本: 8×4090 Spot 约 $2.72/hr；200B tokens 约 $1,110
# 本配置跑通流程的实测成本 < $1

# --- 基础设施 ---
# 在 RunPod console 建 network volume 后填入；必须与 GPU_TYPE 同机房
NETWORK_VOLUME_ID=nv-xxxxxxxxxxxx
# 换成你自己的镜像（在 RunPod Pod 里构建后推送到 Docker Hub）
IMAGE_NAME=yourdockerhub/minimind-runpod:latest

# COMMUNITY + INTERRUPTIBLE=1 走 Spot（便宜约 50%）
CLOUD_TYPE=COMMUNITY
INTERRUPTIBLE=1

POD_NAME=minimind-64m-pretrain
GPU_TYPE=NVIDIA GeForce RTX 4090
GPU_COUNT=8
CONTAINER_DISK_GB=40            # 容器盘易失，只放系统依赖
PORTS=8888/http                 # 可选：Jupyter 便于调试

# --- 数据 ---
# 留空则跳过下载（适用于数据已预置在 network volume 的情况）
# minimind 官方数据集可从 ModelScope 获取，也可填 HF 直链
DATA_URL=

# --- 代码 ---
MINIMIND_REPO=https://github.com/AiMeshes/minimind.git

# --- 凭据（建议改用环境变量注入，不要写进仓库）---
# HF_TOKEN=hf_xxx
# WANDB_API_KEY=xxx

# --- 训练超参（entrypoint 读取，按空格拆分后转发给 train_pretrain.py）---
# 留空使用 minimind 默认值；--use_wandb 需要 WANDB_API_KEY
TRAIN_ARGS=--epochs 2 --batch_size 32 --learning_rate 5e-4 --save_interval 1000

# --- 调试（可选）---
# 设为 1 启动 sshd。本镜像覆盖了基座 ENTRYPOINT，会丢掉 RunPod 的 /start.sh，
# 而长训期间能 SSH 进去看日志/翻 checkpoint 很有价值。公钥由 RunPod 的
# PUBLIC_KEY 环境变量注入（在 console 配置）。
START_SSHD=0
