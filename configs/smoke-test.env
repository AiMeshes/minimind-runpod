# 冒烟测试 —— 用官方镜像跑通全流程，不需要自建镜像
#
# 目的：验证 image → bootstrap → 补装依赖 → 克隆代码 → 下数据 → 训练 → 落 checkpoint
#       这条链路完整可用，再放大到真实配置。
#
# 成本：1×4090 Spot ≈ $0.34/hr。跑 15 分钟约 $0.09。
#       不建 network volume（一次性测试，无需持久化），所以没有常驻费用。
#
# 用法：
#   python launch.py --config configs/smoke-test.env --dry-run
#   python launch.py --config configs/smoke-test.env
#   然后到 https://www.console.runpod.io/pods 看日志

# --- 用官方镜像：零构建成本，代价是启动时补装依赖（几分钟）---
IMAGE_NAME=runpod/pytorch:1.1.0-cu1281-torch260-ubuntu2204

# entrypoint.sh 从仓库拉取（公开仓库，无需认证）
BOOTSTRAP_URL=https://raw.githubusercontent.com/AiMeshes/minimind-runpod/main/entrypoint.sh

# --- 单卡，最小成本 ---
GPU_TYPE=NVIDIA GeForce RTX 4090
GPU_COUNT=1
CONTAINER_DISK_GB=40
PORTS=8888/http,22/tcp

# Spot：便宜约 50%，随时可能被抢占
CLOUD_TYPE=COMMUNITY
INTERRUPTIBLE=1

# --- 不挂 network volume ---
# 冒烟测试不验证持久化，避免产生常驻费用（$0.07/GB/月）
# 真实训练时填入 volume id（见 configs/64m-pretrain.env）
# NETWORK_VOLUME_ID=

# --- 数据：minimind 官方 mini 预训练集，1.24GB ---
# 走 HuggingFace（RunPod 机房同区域 CDN，比 ModelScope 快得多，见成本指南 §9）
DATA_URL=https://huggingface.co/datasets/jingyaogong/minimind_dataset/resolve/main/pretrain_t2t_mini.jsonl

MINIMIND_REPO=https://github.com/AiMeshes/minimind.git

# --- 补装依赖（官方镜像不含 transformers/datasets）---
# 只装预训练需要的两个包，比整份 requirements 快得多
PIP_PACKAGES=transformers==4.57.6 datasets==3.6.0
INSTALL_DEPS=1

# --- SSH：REST 没有日志端点，靠 SSH 进去看训练输出 ---
# 账号里已注册的公钥（与本地 ~/.ssh/id_rsa 匹配）由 RunPod 自动注入 PUBLIC_KEY
START_SSHD=1
PUBLIC_IP=1

# --- 训练超参：够短，只为看到 checkpoint ---
# save_interval 调小到 50，好在几分钟内验证落盘路径
TRAIN_ARGS=--epochs 1 --batch_size 32 --save_interval 50 --log_interval 10
