# network volume + 抢占恢复闭环测试
#
# 目的：验证「真抢占」路径 —— 这是 smoke-test.env 没覆盖的部分。
#   smoke-test 验证的是「容器崩溃」（Pod 保持 RUNNING，RunPod 自动重启容器）
#   本配置验证的是「Pod 转 EXITED 后被 watch.py 从外部拉起」
#
# 关键差异：checkpoint 必须落在 network volume 上，否则 Pod 转 EXITED 后
# 容器盘被擦除，无从续训。
#
# 成本：1×4090 Spot ≈ $0.34/hr + volume 20GB × $0.07/GB/月 = $1.40/月

IMAGE_NAME=runpod/pytorch:1.1.0-cu1281-torch260-ubuntu2204
BOOTSTRAP_URL=https://raw.githubusercontent.com/AiMeshes/minimind-runpod/d1473b629f1d8c567aec34e6e11a894e99f036bb/entrypoint.sh

GPU_TYPE=NVIDIA GeForce RTX 4090
GPU_COUNT=1
CONTAINER_DISK_GB=40
PORTS=8888/http,22/tcp

CLOUD_TYPE=COMMUNITY
INTERRUPTIBLE=1

# ⚠️ network volume 是地域锁定的：Pod 必须开在 volume 所在机房
NETWORK_VOLUME_ID=si7jp5v57w
DATA_CENTER_IDS=US-CA-2

# volume 会挂到 /workspace，于是 minimind 代码/数据/checkpoint 全部落在卷上。
# 复用 smoke-test 已下载的数据（本卷是新的，需重新下载 1.24GB）
DATA_URL=https://huggingface.co/datasets/jingyaogong/minimind_dataset/resolve/main/pretrain_t2t_mini.jsonl

MINIMIND_REPO=https://github.com/AiMeshes/minimind.git

PIP_PACKAGES=transformers==4.57.6 datasets==3.6.0
INSTALL_DEPS=1

START_SSHD=1
PUBLIC_IP=1

# save_interval 调小：要快速看到 checkpoint 落到 volume 上
TRAIN_ARGS=--epochs 1 --batch_size 32 --save_interval 100 --log_interval 20

POD_NAME=minimind-volume-test
